GROQ_API_KEY=your_groq_api_key_here

# FastAPI settings
FRONTEND_ORIGIN=http://localhost:5173
ENVIRONMENT=development
LOG_LEVEL=INFO

# Optional. Defaults to Google's public STUN server.
# STUN_URL=stun:stun.l.google.com:19302

# Optional TURN credentials. Use only if localhost/STUN ICE fails on your network.
# Do not commit real passwords. Values are read in Python from env/secrets and
# passed to streamlit-webrtc RTCConfiguration; they are not hardcoded in JS.
# TURN_URL=turn:your-turn-host:3478
# TURN_USERNAME=your-turn-username
# TURN_CREDENTIAL=your-turn-credential
