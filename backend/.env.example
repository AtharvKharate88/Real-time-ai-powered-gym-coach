GROQ_API_KEY=your_groq_api_key_here
# Minimum spacing between Groq coaching requests for each workout session.
GROQ_MIN_REQUEST_INTERVAL_SECONDS=8

# FastAPI settings
FRONTEND_ORIGIN=http://localhost:5173
# Optional path-aware return URL for static hosts deployed below an origin path.
# For GitHub Pages, set the full HTTPS site URL ending in the repository path.
# FRONTEND_REDIRECT_URL=https://username.github.io/repository-name
ENVIRONMENT=development
LOG_LEVEL=INFO
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
SESSION_SECRET=replace_with_a_long_random_secret
AUTH_COOKIE_NAME=ai_gym_session
COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Neon PostgreSQL. FastAPI uses the pooled endpoint; Alembic uses the direct endpoint.
# Keep the real connection strings in backend/.env and never commit that file.
DATABASE_URL=postgresql+psycopg://ROLE:PASSWORD@YOUR-POOLER-HOST/DATABASE?sslmode=require
DIRECT_DATABASE_URL=postgresql+psycopg://ROLE:PASSWORD@YOUR-DIRECT-HOST/DATABASE?sslmode=require

# Optional. Defaults to Google's public STUN server.
# STUN_URL=stun:stun.l.google.com:19302

# Optional MediaPipe GPU acceleration on a compatible Linux host.
# Windows development stays on CPU inference.
# MEDIAPIPE_USE_GPU=false

# Optional TURN credentials. Use only if localhost/STUN ICE fails on your network.
# Do not commit real passwords. Values are read in Python from env and passed
# to the FastAPI WebRTC server; they are not hardcoded in JS.
# TURN_URL=turn:your-turn-host:3478
# TURN_USERNAME=your-turn-username
# TURN_CREDENTIAL=your-turn-credential
